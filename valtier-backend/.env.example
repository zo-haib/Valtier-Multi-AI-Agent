# ---------------------------------------------------------------------------
# Valtier backend — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=Valtier
ENVIRONMENT=development           # development | staging | production
FRONTEND_URL=http://localhost:5173

# --- Security / JWT ---
# Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=#Your_key
JWT_SECRET_KEY=#Your_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
DATABASE_URL=postgresql+psycopg://#username : #password@localhost:5432/valtier

# --- LLM / Agentic core ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=#Your_api_key
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004
LLM_TEMPERATURE=0.2
VECTOR_STORE_PATH=./data/vector_store

# --- Stripe (billing) ---
# Test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# --- Uploads (RAG document ingestion) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- Usage limits per plan (requests/month, document count) ---
FREE_PLAN_REQUESTS_PER_MONTH=20
FREE_PLAN_DOCUMENT_LIMIT=5
PRO_PLAN_REQUESTS_PER_MONTH=500
PRO_PLAN_DOCUMENT_LIMIT=100
ENTERPRISE_PLAN_REQUESTS_PER_MONTH=5000
ENTERPRISE_PLAN_DOCUMENT_LIMIT=1000

# --- Logging ---
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API with
# credentials (cookies). Never use "*" here — credentialed requests
# require an explicit origin allowlist.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth cookies ---
# AUTH_COOKIE_DOMAIN: empty = current host only
AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SAMESITE: lax | strict | none
AUTH_COOKIE_SAMESITE=lax
